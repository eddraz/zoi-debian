#!/usr/bin/env python3
"""ZOI Wallpaper Color Extraction Engine (Omarchy Quatro Architecture)
Extracts a rich, multi-dominant, vibrant 22-color palette directly from any wallpaper image,
strictly enforcing WCAG AA/AAA contrast ratios while preserving the authentic chromatic
character, ambient tones, and accent highlights of the image.
"""

import argparse
import colorsys
import json
import math
import os
import sys

try:
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
except Exception:
    print("Error: GdkPixbuf (gi) is required for image extraction", file=sys.stderr)
    sys.exit(1)


def clamp(v, lo=0, hi=255):
    return max(lo, min(hi, int(round(v))))


def hexc(c):
    return f"#{clamp(c[0]):02x}{clamp(c[1]):02x}{clamp(c[2]):02x}"


def hls_to_rgb(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h % 1.0, max(0.0, min(1.0, l)), max(0.0, min(1.0, s)))
    return (clamp(r * 255), clamp(g * 255), clamp(b * 255))


def rgb_to_hls(r, g, b):
    return colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)


def srgb_to_linear(v):
    v_norm = v / 255.0
    return v_norm / 12.92 if v_norm <= 0.04045 else ((v_norm + 0.055) / 1.055) ** 2.4


def rel_luminance(c):
    return 0.2126 * srgb_to_linear(c[0]) + 0.7152 * srgb_to_linear(c[1]) + 0.0722 * srgb_to_linear(c[2])


def contrast_ratio(c1, c2):
    l1 = rel_luminance(c1)
    l2 = rel_luminance(c2)
    return (max(l1, l2) + 0.05) / (min(l1, l2) + 0.05)


def ensure_contrast(c, bg, min_cr=4.5, is_bright=True):
    """Adjust color lightness incrementally until minimum contrast ratio is achieved."""
    h, l, s = rgb_to_hls(c[0], c[1], c[2])
    if contrast_ratio(c, bg) >= min_cr:
        return c
    step = 0.015 if is_bright else -0.015
    for _ in range(40):
        l = max(0.04, min(0.99, l + step))
        candidate = hls_to_rgb(h, l, s)
        if contrast_ratio(candidate, bg) >= min_cr:
            return candidate
    return hls_to_rgb(h, l, s)


def extract_palette(image_path):
    # 1. Downsample for high-fidelity color frequency analysis
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(image_path, 220, 220)
    pixels = pb.get_pixels()
    rs = pb.get_rowstride()
    n = pb.get_n_channels()
    w, h = pb.get_width(), pb.get_height()

    color_counts = {}
    for y in range(h):
        for x in range(w):
            o = y * rs + x * n
            if n >= 4 and pixels[o + 3] < 128:
                continue
            r, g, b = pixels[o], pixels[o + 1], pixels[o + 2]
            # 5-bit quantization per channel (32 levels = 32768 bins)
            qr = (r >> 3) << 3
            qg = (g >> 3) << 3
            qb = (b >> 3) << 3
            key = (qr, qg, qb)
            color_counts[key] = color_counts.get(key, 0) + 1

    total_px = max(1, sum(color_counts.values()))
    clusters = []
    for (r, g, b), count in color_counts.items():
        h_val, l_val, s_val = rgb_to_hls(r, g, b)
        weight = count / total_px
        clusters.append({
            "rgb": (r, g, b),
            "hls": (h_val, l_val, s_val),
            "h_deg": h_val * 360.0,
            "weight": weight,
            "chroma": (weight ** 0.32) * s_val * (1.0 - abs(l_val - 0.55) * 1.15)
        })

    if not clusters:
        clusters.append({
            "rgb": (30, 30, 46),
            "hls": (0.66, 0.15, 0.20),
            "h_deg": 240.0,
            "weight": 1.0,
            "chroma": 0.20
        })

    # 2. Extract Dominant Ambient Background Tone
    dark_clusters = [c for c in clusters if c["hls"][1] <= 0.45]
    if dark_clusters:
        dark_clusters.sort(key=lambda c: c["weight"], reverse=True)
        ambient_h = dark_clusters[0]["hls"][0]
        ambient_s = dark_clusters[0]["hls"][2]
    else:
        clusters.sort(key=lambda c: c["weight"], reverse=True)
        ambient_h = clusters[0]["hls"][0]
        ambient_s = clusters[0]["hls"][2]

    # Background hierarchy (calibrated dark mode with authentic image undertone)
    bg_s = min(ambient_s * 0.40, 0.18)
    bg = hls_to_rgb(ambient_h, 0.110, bg_s)
    dark_bg = hls_to_rgb(ambient_h, 0.080, bg_s)
    darker_bg = hls_to_rgb(ambient_h, 0.052, bg_s)
    lighter_bg = hls_to_rgb(ambient_h, 0.180, min(ambient_s * 0.35, 0.15))

    # 3. Extract Top Chromatic Accent from Wallpaper
    vibrant_clusters = [c for c in clusters if c["hls"][2] >= 0.18 and 0.12 <= c["hls"][1] <= 0.88]
    if vibrant_clusters:
        vibrant_clusters.sort(key=lambda c: c["chroma"], reverse=True)
        best_accent = vibrant_clusters[0]
        acc_h = best_accent["hls"][0]
        acc_l = max(0.68, min(0.76, best_accent["hls"][1] * 1.25))
        acc_s = max(0.72, min(0.95, best_accent["hls"][2] * 1.35))
        accent = hls_to_rgb(acc_h, acc_l, acc_s)
    else:
        accent = hls_to_rgb((ambient_h + 0.55) % 1.0, 0.72, 0.80)

    accent = ensure_contrast(accent, bg, min_cr=4.5)

    selection = hls_to_rgb(ambient_h, 0.24, min(ambient_s * 0.50, 0.28))

    # 4. Foreground Hierarchy (Strict WCAG AAA > 7:1 for body and titles)
    fg_s = min(ambient_s * 0.12, 0.06)
    fg = ensure_contrast(hls_to_rgb(ambient_h, 0.90, fg_s), bg, min_cr=7.5)
    dark_fg = ensure_contrast(hls_to_rgb(ambient_h, 0.52, fg_s), bg, min_cr=3.2)
    light_foreground = ensure_contrast(hls_to_rgb(ambient_h, 0.94, fg_s), bg, min_cr=9.0)
    bright_foreground = ensure_contrast(hls_to_rgb(ambient_h, 0.98, fg_s), bg, min_cr=11.0)
    muted = ensure_contrast(hls_to_rgb(ambient_h, 0.65, fg_s), bg, min_cr=4.5)

    # 5. Multi-Color ANSI Syntax Sector Extraction
    # Maps each ANSI syntax role to the best representative color found in the wallpaper
    sectors = [
        ("red", 355, 35, 0.72, 0.82),
        ("orange", 28, 25, 0.72, 0.84),
        ("yellow", 54, 25, 0.75, 0.86),
        ("green", 132, 50, 0.72, 0.76),
        ("cyan", 185, 35, 0.72, 0.80),
        ("blue", 222, 35, 0.72, 0.82),
        ("magenta", 298, 45, 0.72, 0.82),
    ]

    ansi = {}
    for name, target_h_deg, width_deg, target_l, target_s in sectors:
        matching = []
        for c in clusters:
            diff = abs(c["h_deg"] - target_h_deg)
            if diff > 180:
                diff = 360 - diff
            if diff <= width_deg and c["hls"][2] >= 0.12:
                # Rank by cluster weight, saturation, and closeness to sector center
                score = (c["weight"] ** 0.28) * c["hls"][2] * (1.0 - (diff / width_deg) * 0.6)
                matching.append((score, c))
        if matching:
            matching.sort(key=lambda x: x[0], reverse=True)
            best = matching[0][1]
            h_val = best["hls"][0]
            l_val = max(0.68, min(0.78, best["hls"][1] * 1.25))
            s_val = max(target_s, min(0.95, best["hls"][2] * 1.35))
            col = hls_to_rgb(h_val, l_val, s_val)
        else:
            col = hls_to_rgb(target_h_deg / 360.0, target_l, target_s)

        col = ensure_contrast(col, bg, min_cr=4.5)
        ansi[name] = col

    ansi["brown"] = ensure_contrast(hls_to_rgb(22 / 360.0, 0.48, 0.45), bg, min_cr=3.2)

    # 6. Bright ANSI 6 Variants (High-visibility for CLI and syntax highlighters)
    bright = {}
    for name in ["red", "yellow", "green", "cyan", "blue", "magenta"]:
        h_val, l_val, s_val = rgb_to_hls(ansi[name][0], ansi[name][1], ansi[name][2])
        b_col = hls_to_rgb(h_val, min(0.86, l_val + 0.10), min(0.98, s_val * 1.10))
        bright[f"bright_{name}"] = ensure_contrast(b_col, bg, min_cr=6.0)

    return {
        "id": "wallpaper",
        "name": "Wallpaper",
        "mode": "dark",
        "accent": hexc(accent),
        "selection": hexc(selection),
        "muted": hexc(muted),
        "background": hexc(bg),
        "dark_background": hexc(dark_bg),
        "darker_background": hexc(darker_bg),
        "lighter_background": hexc(lighter_bg),
        "foreground": hexc(fg),
        "dark_foreground": hexc(dark_fg),
        "light_foreground": hexc(light_foreground),
        "bright_foreground": hexc(bright_foreground),
        "red": hexc(ansi["red"]),
        "yellow": hexc(ansi["yellow"]),
        "orange": hexc(ansi["orange"]),
        "green": hexc(ansi["green"]),
        "cyan": hexc(ansi["cyan"]),
        "blue": hexc(ansi["blue"]),
        "magenta": hexc(ansi["magenta"]),
        "brown": hexc(ansi["brown"]),
        "bright_red": hexc(bright["bright_red"]),
        "bright_yellow": hexc(bright["bright_yellow"]),
        "bright_green": hexc(bright["bright_green"]),
        "bright_cyan": hexc(bright["bright_cyan"]),
        "bright_blue": hexc(bright["bright_blue"]),
        "bright_magenta": hexc(bright["bright_magenta"]),
        # Aliases for compatibility
        "mantle": hexc(dark_bg),
        "crust": hexc(darker_bg),
        "surface": hexc(lighter_bg),
        "overlay": hexc(muted),
        "urgent": hexc(ansi["red"]),
        "peach": hexc(ansi["orange"])
    }


def main():
    parser = argparse.ArgumentParser(description="Extract rich 22-color Omarchy Quatro palette from wallpaper")
    parser.add_argument("image_path", help="Path to wallpaper image")
    parser.add_argument("--json", action="store_true", help="Output JSON format")
    args = parser.parse_args()

    path = os.path.expanduser(args.image_path)
    if not os.path.isfile(path):
        print(f"Error: image not found: {path}", file=sys.stderr)
        return 1

    try:
        pal = extract_palette(path)
    except Exception as e:
        print(f"Error extracting palette: {e}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(pal, indent=2))
    else:
        for k, v in pal.items():
            print(f"{k}={v}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

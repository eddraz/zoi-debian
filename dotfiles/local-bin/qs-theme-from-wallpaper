#!/usr/bin/env python3
"""Extract a rich, harmonious, high-contrast 22-color Omarchy Quatro palette from a wallpaper image.
Outputs key=value pairs (or JSON with --json).
"""

import argparse
import colorsys
import json
import math
import os
import sys

try:
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
except Exception:
    sys.exit(1)


def clamp(v, lo=0, hi=255):
    return max(lo, min(hi, int(round(v))))


def hexc(c):
    return f"#{clamp(c[0]):02x}{clamp(c[1]):02x}{clamp(c[2]):02x}"


def hls_to_rgb(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h % 1.0, max(0.0, min(1.0, l)), max(0.0, min(1.0, s)))
    return (clamp(r * 255), clamp(g * 255), clamp(b * 255))


def rgb_to_hls(r, g, b):
    return colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)


def rel_lum(c):
    def chan(v):
        v_lin = v / 255.0
        return v_lin / 12.92 if v_lin <= 0.04045 else ((v_lin + 0.055) / 1.055) ** 2.4
    return 0.2126 * chan(c[0]) + 0.7152 * chan(c[1]) + 0.0722 * chan(c[2])


def extract_palette(image_path):
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(image_path, 160, 160)
    pixels = pb.get_pixels()
    rs = pb.get_rowstride()
    n = pb.get_n_channels()
    w, h = pb.get_width(), pb.get_height()

    points = []
    vibrant = []

    for y in range(h):
        for x in range(w):
            o = y * rs + x * n
            r, g, b = pixels[o], pixels[o + 1], pixels[o + 2]
            h_val, l_val, s_val = rgb_to_hls(r, g, b)
            points.append((r, g, b, h_val, l_val, s_val))
            if s_val >= 0.18 and 0.12 <= l_val <= 0.88:
                vibrant.append((r, g, b, h_val, l_val, s_val))

    # Dominant hue
    if vibrant:
        sorted_v = sorted(vibrant, key=lambda p: p[5], reverse=True)
        dom_h = sorted_v[0][3]
        dom_s = sorted_v[0][5]
    else:
        dom_h = points[0][3] if points else 0.6
        dom_s = 0.2

    # 1. Background hierarchy (subtle wallpaper tint, deep dark tone)
    bg_s = min(dom_s * 0.35, 0.16)
    bg = hls_to_rgb(dom_h, 0.11, bg_s)
    dark_bg = hls_to_rgb(dom_h, 0.08, bg_s)
    darker_bg = hls_to_rgb(dom_h, 0.055, bg_s)
    lighter_bg = hls_to_rgb(dom_h, 0.18, min(dom_s * 0.30, 0.14))

    # 2. Foreground hierarchy (WCAG AAA contrast > 7:1)
    fg_s = min(dom_s * 0.15, 0.08)
    fg = hls_to_rgb(dom_h, 0.90, fg_s)
    dark_fg = hls_to_rgb(dom_h, 0.50, fg_s)
    light_fg = hls_to_rgb(dom_h, 0.93, fg_s)
    bright_fg = hls_to_rgb(dom_h, 0.98, fg_s)
    muted = hls_to_rgb(dom_h, 0.65, fg_s)

    # 3. Vibrant Accents from image
    def find_hue_in_points(h_deg_center, width_deg=35, target_l=0.72, min_s=0.68):
        c_h = h_deg_center / 360.0
        w_h = width_deg / 360.0
        matches = []
        for p in vibrant:
            diff = abs(p[3] - c_h)
            if diff > 0.5:
                diff = 1.0 - diff
            if diff <= w_h:
                score = p[5] * 2.0 + (1.0 - diff)
                matches.append((score, p))
        if matches:
            matches.sort(key=lambda x: x[0], reverse=True)
            best = matches[0][1]
            return hls_to_rgb(best[3], max(0.65, min(0.78, best[4])), max(min_s, min(0.92, best[5] * 1.3)))
        else:
            return hls_to_rgb(c_h, target_l, min_s)

    # Standout primary accent
    if vibrant:
        best_v = sorted(vibrant, key=lambda p: p[5] * 2.0 + (0.5 - abs(p[4] - 0.5)), reverse=True)[0]
        accent = hls_to_rgb(best_v[3], max(0.68, min(0.78, best_v[4])), max(0.68, min(0.92, best_v[5] * 1.35)))
    else:
        accent = hls_to_rgb((dom_h + 0.55) % 1.0, 0.74, 0.75)

    selection = hls_to_rgb(dom_h, 0.22, min(dom_s * 0.40, 0.25))

    # ANSI 8 Colors
    red = find_hue_in_points(355, 30, target_l=0.70, min_s=0.75)
    orange = find_hue_in_points(28, 25, target_l=0.72, min_s=0.78)
    yellow = find_hue_in_points(52, 25, target_l=0.75, min_s=0.82)
    green = find_hue_in_points(130, 40, target_l=0.72, min_s=0.68)
    cyan = find_hue_in_points(185, 35, target_l=0.72, min_s=0.70)
    blue = find_hue_in_points(220, 35, target_l=0.72, min_s=0.75)
    magenta = find_hue_in_points(285, 40, target_l=0.72, min_s=0.75)
    brown = hls_to_rgb(20 / 360.0, 0.45, 0.40)

    # Bright ANSI 6
    bright_red = hls_to_rgb(355 / 360.0, 0.78, 0.85)
    bright_yellow = hls_to_rgb(52 / 360.0, 0.82, 0.90)
    bright_green = hls_to_rgb(130 / 360.0, 0.80, 0.80)
    bright_cyan = hls_to_rgb(185 / 360.0, 0.80, 0.85)
    bright_blue = hls_to_rgb(220 / 360.0, 0.80, 0.85)
    bright_magenta = hls_to_rgb(285 / 360.0, 0.80, 0.85)

    return {
        "id": "wallpaper",
        "name": "Wallpaper",
        "mode": "dark",
        "accent": hexc(accent),
        "selection": hexc(selection),
        "muted": hexc(muted),
        "background": hexc(bg),
        "dark_background": hexc(dark_bg),
        "darker_background": hexc(darker_bg),
        "lighter_background": hexc(lighter_bg),
        "foreground": hexc(fg),
        "dark_foreground": hexc(dark_fg),
        "light_foreground": hexc(light_fg),
        "bright_foreground": hexc(bright_fg),
        "red": hexc(red),
        "yellow": hexc(yellow),
        "orange": hexc(orange),
        "green": hexc(green),
        "cyan": hexc(cyan),
        "blue": hexc(blue),
        "magenta": hexc(magenta),
        "brown": hexc(brown),
        "bright_red": hexc(bright_red),
        "bright_yellow": hexc(bright_yellow),
        "bright_green": hexc(bright_green),
        "bright_cyan": hexc(bright_cyan),
        "bright_blue": hexc(bright_blue),
        "bright_magenta": hexc(bright_magenta),
        # Legacy aliases
        "mantle": hexc(dark_bg),
        "crust": hexc(darker_bg),
        "surface": hexc(lighter_bg),
        "overlay": hexc(muted),
        "urgent": hexc(red),
        "peach": hexc(orange)
    }


def main():
    parser = argparse.ArgumentParser(description="Extract 22-color palette from wallpaper")
    parser.add_argument("image_path", help="Path to wallpaper image")
    parser.add_argument("--json", action="store_true", help="Output JSON instead of key=value")
    args = parser.parse_args()

    path = os.path.expanduser(args.image_path)
    if not os.path.isfile(path):
        print(f"Error: image not found: {path}", file=sys.stderr)
        return 1

    try:
        pal = extract_palette(path)
    except Exception as e:
        print(f"Error extracting palette: {e}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(pal, indent=2))
    else:
        for k, v in pal.items():
            print(f"{k}={v}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

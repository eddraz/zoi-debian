#!/usr/bin/env python3
"""Output current WiFi quality as JSON."""
import json
import re
import subprocess
import sys


def run(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, timeout=3).decode()
    except Exception:
        return ""


def iface():
    nm = run("nmcli -t -f DEVICE,TYPE,STATE | awk -F: '$2 == \"wifi\" {print $1; exit}'")
    if nm.strip():
        return nm.strip()
    w = open("/proc/net/wireless").read().splitlines()
    for line in w:
        m = re.match(r"\s*(\S+):", line)
        if m:
            return m.group(1).strip()
    return "wlo1"


def main():
    dev = iface()
    quality = 0
    signal = 0
    ssid = ""

    nm = run(f"nmcli -t -f ACTIVE,SIGNAL,SSID,DEVICE | awk -F: '($1 == \"sí\" || $1 == \"yes\") && $4 == \"{dev}\" {{print $2, $3}}'")
    if not nm.strip():
        nm = run(f"nmcli -t -f IN-USE,SIGNAL,SSID dev wifi | awk -F: '($1 == \"*\") {{print $2, $3}}'")
    if nm.strip():
        parts = nm.strip().split()
        if parts:
            try:
                signal = int(parts[0])
            except ValueError:
                pass
            if len(parts) > 1:
                ssid = parts[1]

    proc = run(f"cat /proc/net/wireless | grep -E '^[ ]*{dev}:'")
    if proc:
        m = re.search(r"Quality=(\d+)/(\d+)", proc)
        if m:
            quality = round(100 * int(m.group(1)) / int(m.group(2)))
        m = re.search(r"Signal level=(-?\d+)", proc)
        if m:
            try:
                dbm = int(m.group(1))
                if -100 <= dbm <= 0:
                    signal = max(0, min(100, 2 * (dbm + 100)))
            except ValueError:
                pass

    if quality == 0 and signal > 0:
        quality = signal

    out = {
        "iface": dev,
        "ssid": ssid,
        "quality": quality,
        "signal": signal,
    }
    print(json.dumps(out))


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Apply ZOI theme colors across all system applications:
- Terminal (foot)
- Herdr AI Workspace Manager
- Helix Editor
- Zed Editor
- Antigravity IDE / VS Code / Code-OSS / VSCodium
- Sway Window Manager
- GTK 3 & 4 / Browsers (Chromium, Chrome, LibreWolf, Brave)
- Central State (~/.local/state/quickshell/colors.json & colors.sh)
"""

import json
import os
import re
import subprocess
import sys


def strip_hash(color_str):
    s = str(color_str or "").strip()
    return s[1:] if s.startswith("#") else s


def with_hash(color_str):
    s = str(color_str or "").strip()
    return s if s.startswith("#") else ("#" + s)


def apply_foot(pal, home):
    foot_path = os.path.join(home, ".config/foot/foot.ini")
    os.makedirs(os.path.dirname(foot_path), exist_ok=True)
    
    bg = strip_hash(pal.get("background", "1e1e2e"))
    fg = strip_hash(pal.get("foreground", "cdd6f4"))
    crust = strip_hash(pal.get("crust", "11111b"))
    surface = strip_hash(pal.get("surface", "313244"))
    overlay = strip_hash(pal.get("overlay", "6c7086"))
    muted = strip_hash(pal.get("muted", "a6adc8"))
    accent = strip_hash(pal.get("accent", "89b4fa"))
    urgent = strip_hash(pal.get("urgent", "f38ba8"))
    green = strip_hash(pal.get("green", "a6e3a1"))
    peach = strip_hash(pal.get("peach", "fab387"))
    yellow = strip_hash(pal.get("yellow", "f9e2af"))

    content = f"""[main]
shell=/usr/bin/fish
font=DejaVu Sans Mono:size=11
pad=4x4

[colors]
background={bg}
foreground={fg}

## Normal / regular colors (8)
regular0={crust}
regular1={urgent}
regular2={green}
regular3={yellow}
regular4={accent}
regular5={peach}
regular6={accent}
regular7={fg}

## Bright colors (8)
bright0={overlay}
bright1={urgent}
bright2={green}
bright3={yellow}
bright4={accent}
bright5={peach}
bright6={accent}
bright7={fg}

## Selection
selection-foreground={crust}
selection-background={accent}
"""
    try:
        with open(foot_path, "w", encoding="utf-8") as f:
            f.write(content)
        # Also sync to repo dotfiles if it exists
        repo_foot = os.path.join(home, "projects/zoi-debian/dotfiles/config/foot/foot.ini")
        if os.path.isdir(os.path.dirname(repo_foot)):
            with open(repo_foot, "w", encoding="utf-8") as f:
                f.write(content)
    except Exception as e:
        print(f"Error applying foot theme: {e}", file=sys.stderr)


def apply_herdr(pal, home, theme_id):
    herdr_cfg = os.path.join(home, ".config/herdr/config.toml")
    if not os.path.exists(herdr_cfg):
        return

    # Map theme_id to herdr built-in theme
    theme_map = {
        "mocha": "catppuccin",
        "macchiato": "catppuccin",
        "frappe": "catppuccin",
        "latte": "catppuccin-latte",
        "kanagawa": "kanagawa",
        "nord": "nord",
        "gruvbox": "gruvbox",
        "dracula": "dracula",
        "rosepine": "rose-pine",
    }
    herdr_theme = theme_map.get(theme_id, "catppuccin")

    try:
        with open(herdr_cfg, "r", encoding="utf-8") as f:
            lines = f.readlines()
        
        new_lines = []
        in_theme = False
        replaced = False
        for line in lines:
            if line.strip().startswith("[theme]"):
                in_theme = True
                new_lines.append(line)
                continue
            if in_theme and line.strip().startswith("name ="):
                new_lines.append(f'name = "{herdr_theme}"\n')
                replaced = True
                in_theme = False
                continue
            if in_theme and line.startswith("["):
                if not replaced:
                    new_lines.append(f'name = "{herdr_theme}"\n')
                    replaced = True
                in_theme = False
            new_lines.append(line)
        
        if not replaced and "[theme]" not in "".join(lines):
            new_lines.append(f'\n[theme]\nname = "{herdr_theme}"\nauto_switch = false\n')

        with open(herdr_cfg, "w", encoding="utf-8") as f:
            f.writelines(new_lines)

        # Notify running herdr server
        subprocess.run(["herdr", "server", "reload-config"], capture_output=True, timeout=1)
    except Exception:
        pass



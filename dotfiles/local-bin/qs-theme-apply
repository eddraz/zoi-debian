def apply_sway(pal, home):
    bg = with_hash(pal.get("background", "#1e1e2e"))
    crust = with_hash(pal.get("crust", "#11111b"))
    mantle = with_hash(pal.get("mantle", "#181825"))
    surface = with_hash(pal.get("surface", "#313244"))
    fg = with_hash(pal.get("foreground", "#cdd6f4"))
    muted = with_hash(pal.get("muted", "#a6adc8"))
    accent = with_hash(pal.get("accent", "#89b4fa"))
    urgent = with_hash(pal.get("urgent", "#f38ba8"))
    peach = with_hash(pal.get("peach", "#fab387"))

    # 1. Write theme.conf for Sway persistence
    sway_theme_path = os.path.join(home, ".config/sway/theme.conf")
    os.makedirs(os.path.dirname(sway_theme_path), exist_ok=True)

    content = f"""# Generated by ZOI Theme Manager
client.focused {accent} {accent} {crust} {peach} {accent}
client.focused_inactive {surface} {surface} {fg} {surface} {surface}
client.unfocused {mantle} {mantle} {muted} {mantle} {mantle}
client.urgent {urgent} {urgent} {crust} {urgent} {urgent}
client.placeholder {crust} {crust} {muted} {crust} {crust}
"""
    try:
        with open(sway_theme_path, "w", encoding="utf-8") as f:
            f.write(content)
        repo_sway = os.path.join(home, "projects/zoi-debian/dotfiles/sway/theme.conf")
        if os.path.isdir(os.path.dirname(repo_sway)):
            with open(repo_sway, "w", encoding="utf-8") as f:
                f.write(content)
    except Exception as e:
        print(f"Error writing sway theme.conf: {e}", file=sys.stderr)

    # 2. Live Sway client colors via IPC
    cmd = [
        "swaymsg",
        f"client.focused '{accent}' '{accent}' '{crust}' '{peach}' '{accent}'; "
        f"client.focused_inactive '{surface}' '{surface}' '{fg}' '{surface}' '{surface}'; "
        f"client.unfocused '{mantle}' '{mantle}' '{muted}' '{mantle}' '{mantle}'; "
        f"client.urgent '{urgent}' '{urgent}' '{crust}' '{urgent}' '{urgent}'"
    ]
    subprocess.run(cmd, capture_output=True, timeout=1)


def apply_gtk_browsers(pal, home, theme_id):
    # Set GNOME color scheme for browsers & GTK4 apps (dark vs light)
    scheme = "prefer-light" if theme_id == "latte" else "prefer-dark"
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme], capture_output=True)

    bg = with_hash(pal.get("background", "#1e1e2e"))
    mantle = with_hash(pal.get("mantle", "#181825"))
    surface = with_hash(pal.get("surface", "#313244"))
    fg = with_hash(pal.get("foreground", "#cdd6f4"))
    accent = with_hash(pal.get("accent", "#89b4fa"))
    crust = with_hash(pal.get("crust", "#11111b"))

    css_content = f"""/* Generated by ZOI Theme Manager */
@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {crust};
@define-color window_bg_color {bg};
@define-color window_fg_color {fg};
@define-color view_bg_color {bg};
@define-color view_fg_color {fg};
@define-color headerbar_bg_color {mantle};
@define-color headerbar_fg_color {fg};
@define-color card_bg_color {surface};
@define-color card_fg_color {fg};
@define-color popover_bg_color {surface};
@define-color popover_fg_color {fg};
"""
    for gtk_ver in ["gtk-3.0", "gtk-4.0"]:
        d = os.path.join(home, ".config", gtk_ver)
        os.makedirs(d, exist_ok=True)
        css_file = os.path.join(d, "gtk.css")
        try:
            with open(css_file, "w", encoding="utf-8") as f:
                f.write(css_content)
        except Exception:
            pass


def apply_state_files(pal, home, theme_id):
    state_dir = os.path.join(home, ".local/state/quickshell")
    os.makedirs(state_dir, exist_ok=True)

    # 1. colors.json
    with open(os.path.join(state_dir, "colors.json"), "w", encoding="utf-8") as f:
        json.dump(pal, f, indent=2)

    # 2. colors.sh (sourceable in bash/zsh/fish)
    lines = [f'export ZOI_THEME="{theme_id}"\n']
    for k, v in pal.items():
        lines.append(f'export ZOI_COLOR_{k.upper()}="{with_hash(v)}"\n')
    with open(os.path.join(state_dir, "colors.sh"), "w", encoding="utf-8") as f:
        f.writelines(lines)


def main():
    if len(sys.argv) < 2:
        return 2
    raw = sys.argv[1]
    home = os.path.expanduser("~")

    try:
        pal = json.loads(raw)
    except Exception as e:
        print(f"Invalid JSON palette: {e}", file=sys.stderr)
        return 1

    theme_id = pal.get("id", "mocha")

    # Apply across all supported apps
    apply_foot(pal, home)
    apply_herdr(pal, home, theme_id)
    apply_helix(pal, home)
    apply_zed(pal, home)
    apply_vscode_family(pal, home)
    apply_btop(pal, home)
    apply_sway(pal, home)
    apply_gtk_browsers(pal, home, theme_id)
    apply_state_files(pal, home, theme_id)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

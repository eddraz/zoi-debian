def main():
    mgr = ZoiThemeManager()

    # 1. Fast handling of direct JSON palette argument (from Quickshell UI or scripts)
    if len(sys.argv) > 1:
        first_arg = sys.argv[1].strip()
        if first_arg.startswith("{"):
            try:
                raw_dict = json.loads(first_arg)
                pal = normalize_palette(raw_dict, theme_id=raw_dict.get("id", "custom"))
                mgr.apply_palette(pal)
                print(f"Applied palette JSON: {pal.get('name', 'Custom')} ({pal.get('id', 'custom')})")
                return 0
            except Exception as e:
                print(f"Error parsing JSON palette: {e}", file=sys.stderr)
                return 1

        # 2. Fast handling of direct theme name: `zoi-theme tokyo-night` or `qs-theme-apply retro-82`
        known_subcommands = {"list", "current", "get", "set", "apply-json", "-h", "--help"}
        if first_arg not in known_subcommands and not first_arg.startswith("-"):
            try:
                pal = mgr.get_theme_palette(first_arg)
                mgr.apply_palette(pal)
                print(f"Applied theme: {pal['name']} ({first_arg})")
                return 0
            except Exception:
                pass

    parser = argparse.ArgumentParser(description="ZOI Theme Engine & Manager")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("list", help="List available themes")
    subparsers.add_parser("current", help="Show current theme ID")

    get_p = subparsers.add_parser("get", help="Get theme palette definition")
    get_p.add_argument("theme_id", help="Theme ID")

    set_p = subparsers.add_parser("set", help="Set theme by ID")
    set_p.add_argument("theme_id", help="Theme ID")

    apply_json_p = subparsers.add_parser("apply-json", help="Apply custom palette from JSON")
    apply_json_p.add_argument("json_str", help="Palette JSON string")

    args = parser.parse_args()

    if args.command == "list":
        themes = mgr.list_themes()
        print(json.dumps(themes, indent=2))
        return 0

    elif args.command == "current":
        state_file = os.path.join(mgr.qs_state_dir, "theme")
        if os.path.exists(state_file):
            with open(state_file, "r") as f:
                print(f.read().strip())
        else:
            print("mocha")
        return 0

    elif args.command == "get":
        try:
            pal = mgr.get_theme_palette(args.theme_id)
            print(json.dumps(pal, indent=2))
            return 0
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            return 1

    elif args.command == "set":
        try:
            pal = mgr.get_theme_palette(args.theme_id)
            mgr.apply_palette(pal)
            print(f"Applied theme: {pal['name']} ({args.theme_id})")
            return 0
        except Exception as e:
            print(f"Error setting theme {args.theme_id}: {e}", file=sys.stderr)
            return 1

    elif args.command == "apply-json":
        try:
            raw_dict = json.loads(args.json_str)
            pal = normalize_palette(raw_dict, theme_id=raw_dict.get("id", "custom"))
            mgr.apply_palette(pal)
            print(f"Applied palette: {pal['name']} ({pal['id']})")
            return 0
        except Exception as e:
            print(f"Error applying palette JSON: {e}", file=sys.stderr)
            return 1

    parser.print_help()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

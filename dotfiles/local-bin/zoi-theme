def dump_toml(data):
    lines = []
    for k, v in data.items():
        if not isinstance(v, dict):
            if isinstance(v, bool):
                b_str = "true" if v else "false"
                lines.append(f"{k} = {b_str}\n")
            elif isinstance(v, (int, float)):
                lines.append(f"{k} = {v}\n")
            elif isinstance(v, str):
                lines.append(f'{k} = "{v}"\n')
            elif isinstance(v, list):
                lines.append(f"{k} = {json.dumps(v)}\n")
    if lines:
        lines.append("\n")

    def emit_table(prefix, table):
        t_lines = []
        sub_tables = []
        for k, v in table.items():
            if isinstance(v, dict):
                sub_tables.append((k, v))
            else:
                if isinstance(v, bool):
                    b_str = "true" if v else "false"
                    t_lines.append(f"{k} = {b_str}\n")
                elif isinstance(v, (int, float)):
                    t_lines.append(f"{k} = {v}\n")
                elif isinstance(v, str):
                    t_lines.append(f'{k} = "{v}"\n')
                elif isinstance(v, list):
                    t_lines.append(f"{k} = {json.dumps(v)}\n")
        
        res = []
        if t_lines or not sub_tables:
            res.append(f"[{prefix}]\n")
            res.extend(t_lines)
            res.append("\n")
        for sub_k, sub_v in sub_tables:
            sub_prefix = f"{prefix}.{sub_k}" if prefix else sub_k
            res.extend(emit_table(sub_prefix, sub_v))
        return res

    for k, v in data.items():
        if isinstance(v, dict):
            lines.extend(emit_table(k, v))

    return "".join(lines).strip() + "\n"


def hex_to_rgb(h):
    s = str(h or "").strip().lstrip("#")
    if len(s) == 3:
        s = "".join([c * 2 for c in s])
    if len(s) != 6:
        return (128, 128, 128)
    try:
        return tuple(int(s[i:i+2], 16) for i in (0, 2, 4))
    except ValueError:
        return (128, 128, 128)


# Lemurs named ANSI → kernel VT slots (setvtrgb). Hex is ignored on TTY2.
# 0 black=background, 7 gray=muted, 8 dark gray=surface,
# 11 light yellow=accent (focused chrome), 15 white=foreground.
VT_SLOTS = (
    "background",
    "red",
    "green",
    "yellow",
    "blue",
    "magenta",
    "cyan",
    "muted",
    "surface",
    "bright_red",
    "bright_green",
    "accent",
    "bright_blue",
    "bright_magenta",
    "bright_cyan",
    "foreground",
)


def palette_to_vtrgb(pal):
    rgbs = [hex_to_rgb(pal.get(key, "#808080")) for key in VT_SLOTS]
    reds = ",".join(str(r) for r, g, b in rgbs)
    greens = ",".join(str(g) for r, g, b in rgbs)
    blues = ",".join(str(b) for r, g, b in rgbs)
    return f"{reds}\n{greens}\n{blues}\n"



def rgb_to_hex(r, g, b):
    r_c = max(0, min(255, int(round(r))))
    g_c = max(0, min(255, int(round(g))))
    b_c = max(0, min(255, int(round(b))))
    return f"#{r_c:02x}{g_c:02x}{b_c:02x}"


def luminance(hex_color):
    r, g, b = hex_to_rgb(hex_color)
    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0


def mix_colors(c1, c2, ratio):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(
        r1 * (1.0 - ratio) + r2 * ratio,
        g1 * (1.0 - ratio) + g2 * ratio,
        b1 * (1.0 - ratio) + b2 * ratio,
    )


def with_hash(s):
    s = str(s or "").strip()
    return s if s.startswith("#") else ("#" + s)


def strip_hash(s):
    s = str(s or "").strip()
    return s[1:] if s.startswith("#") else s


def normalize_palette(raw_dict, theme_id="custom", theme_name="Custom"):
    """Normalize any dictionary into the standard 22-color Omarchy Quatro palette."""
    pal = dict(raw_dict)
    
    # 1. Base identification & mode
    bg = with_hash(pal.get("background", "#1e1e2e"))
    lum = luminance(bg)
    is_dark = lum < 0.4
    default_mode = "dark" if is_dark else "light"
    mode = pal.get("mode", default_mode)

    pal["id"] = pal.get("id", theme_id)
    pal["name"] = pal.get("name", theme_name or theme_id.replace("-", " ").title())
    pal["mode"] = mode

    # 2. Main colors
    fg = with_hash(pal.get("foreground", "#cdd6f4" if is_dark else "#4c4f69"))
    accent = with_hash(pal.get("accent", "#89b4fa" if is_dark else "#1e66f5"))
    
    pal["background"] = bg
    pal["foreground"] = fg
    pal["accent"] = accent

    # 3. Hierarchy backgrounds
    if "dark_background" not in pal:
        pal["dark_background"] = pal.get("mantle", mix_colors(bg, "#000000" if is_dark else "#ffffff", 0.15))
    if "darker_background" not in pal:
        pal["darker_background"] = pal.get("crust", mix_colors(bg, "#000000" if is_dark else "#ffffff", 0.30))
    if "lighter_background" not in pal:
        pal["lighter_background"] = pal.get("surface", mix_colors(bg, "#ffffff" if is_dark else "#000000", 0.12))

    # 4. Selection & Muted
    if "selection" not in pal:
        pal["selection"] = mix_colors(bg, accent, 0.25 if is_dark else 0.18)
    if "muted" not in pal:
        pal["muted"] = pal.get("overlay", mix_colors(fg, bg, 0.55))

    # 5. Foreground hierarchy
    if "dark_foreground" not in pal:
        pal["dark_foreground"] = mix_colors(fg, bg, 0.40)
    if "light_foreground" not in pal:
        pal["light_foreground"] = mix_colors(fg, "#ffffff" if is_dark else "#000000", 0.15)
    if "bright_foreground" not in pal:
        pal["bright_foreground"] = mix_colors(fg, "#ffffff" if is_dark else "#000000", 0.35)

    # 6. Standard 8 ANSI colors
    if "red" not in pal:
        pal["red"] = pal.get("urgent", "#f38ba8" if is_dark else "#d20f39")
    if "green" not in pal:
        pal["green"] = pal.get("green", "#a6e3a1" if is_dark else "#40a02b")
    if "yellow" not in pal:
        pal["yellow"] = pal.get("yellow", "#f9e2af" if is_dark else "#df8e1d")
    if "orange" not in pal:
        pal["orange"] = pal.get("peach", "#fab387" if is_dark else "#fe640b")
    if "blue" not in pal:
        pal["blue"] = accent
    if "magenta" not in pal:
        pal["magenta"] = pal.get("magenta", "#cba6f7" if is_dark else "#8839ef")
    if "cyan" not in pal:
        pal["cyan"] = pal.get("cyan", "#94e2d5" if is_dark else "#179299")
    if "brown" not in pal:
        pal["brown"] = mix_colors(pal["orange"], "#000000", 0.3)

    # 7. Bright 6 ANSI colors
    if "bright_red" not in pal:
        pal["bright_red"] = mix_colors(pal["red"], "#ffffff" if is_dark else "#000000", 0.2)
    if "bright_yellow" not in pal:
        pal["bright_yellow"] = mix_colors(pal["yellow"], "#ffffff" if is_dark else "#000000", 0.2)
    if "bright_green" not in pal:
        pal["bright_green"] = mix_colors(pal["green"], "#ffffff" if is_dark else "#000000", 0.2)
    if "bright_cyan" not in pal:
        pal["bright_cyan"] = mix_colors(pal["cyan"], "#ffffff" if is_dark else "#000000", 0.2)
    if "bright_blue" not in pal:
        pal["bright_blue"] = mix_colors(pal["blue"], "#ffffff" if is_dark else "#000000", 0.2)
    if "bright_magenta" not in pal:
        pal["bright_magenta"] = mix_colors(pal["magenta"], "#ffffff" if is_dark else "#000000", 0.2)

    # 8. Backward-compatible aliases for legacy components
    pal["mantle"] = pal["dark_background"]
    pal["crust"] = pal["darker_background"]
    pal["surface"] = pal["lighter_background"]
    pal["overlay"] = pal["muted"]
    pal["urgent"] = pal["red"]
    pal["peach"] = pal["orange"]

    for k in list(pal.keys()):
        if k not in ["id", "name", "mode"]:
            pal[k] = with_hash(pal[k])

    return pal


def render_template(template_str, pal):
    """Render a .tpl template string replacing moustache tags."""
    
    def replace_mix(match):
        func = match.group(1) or "mix"
        c1_key = match.group(2)
        c2_key = match.group(3)
        pct_str = match.group(4)

        if pct_str.endswith("%"):
            ratio = float(pct_str[:-1]) / 100.0
        else:
            ratio = float(pct_str)

        c1 = pal.get(c1_key, "#ffffff")
        c2 = pal.get(c2_key, "#000000")
        mixed = mix_colors(c1, c2, ratio)

        if "strip" in func:
            return strip_hash(mixed)
        elif "rgb" in func:
            r, g, b = hex_to_rgb(mixed)
            return f"{r}, {g}, {b}"
        return mixed

    pattern_mix = re.compile(r"\{\{\s*(mix(?:_strip|_rgb)?)\s+([a-zA-Z0-9_]+)\s+([a-zA-Z0-9_]+)\s+([0-9.]+%?)\s*\}\}")
    rendered = pattern_mix.sub(replace_mix, template_str)

    def replace_var(match):
        full_key = match.group(1).strip()
        if full_key.endswith("_strip"):
            base_k = full_key[:-6]
            val = pal.get(base_k, "")
            return strip_hash(val)
        elif full_key.endswith("_rgb"):
            base_k = full_key[:-4]
            val = pal.get(base_k, "#ffffff")
            r, g, b = hex_to_rgb(val)
            return f"{r}, {g}, {b}"
        else:
            return str(pal.get(full_key, match.group(0)))

    pattern_var = re.compile(r"\{\{\s*([a-zA-Z0-9_]+)\s*\}\}")
    rendered = pattern_var.sub(replace_var, rendered)

    return rendered


class ZoiThemeManager:
    def __init__(self):
        self.home = os.path.expanduser("~")
        self.script_dir = os.path.dirname(os.path.realpath(__file__))
        self.repo_root = os.path.abspath(os.path.join(self.script_dir, "../.."))
        
        self.tpl_search_dirs = [
            os.path.join(self.home, ".config/zoi/themed"),
            os.path.join(self.home, ".local/share/zoi/templates"),
            os.path.join(self.repo_root, "dotfiles/themes/templates"),
            os.path.join(self.home, "projects/zoi-debian/dotfiles/themes/templates"),
            "/usr/share/zoi/templates"
        ]
        
        self.theme_search_dirs = [
            os.path.join(self.home, ".config/zoi/themes"),
            os.path.join(self.home, ".local/share/zoi/themes"),
            os.path.join(self.repo_root, "dotfiles/themes"),
            os.path.join(self.home, "projects/zoi-debian/dotfiles/themes"),
            "/usr/share/zoi/themes"
        ]
        
        self.state_dir = os.path.join(self.home, ".local/state/zoi/theme")
        self.qs_state_dir = os.path.join(self.home, ".local/state/quickshell")
        os.makedirs(self.state_dir, exist_ok=True)
        os.makedirs(self.qs_state_dir, exist_ok=True)
        os.makedirs(os.path.join(self.home, ".config/zoi/themes"), exist_ok=True)
        os.makedirs(os.path.join(self.home, ".config/zoi/themed"), exist_ok=True)

        self.lock_file = os.path.join(self.state_dir, "theme.lock")

    def list_themes(self):
        themes = {}
        for search_dir in reversed(self.theme_search_dirs):
            if not os.path.isdir(search_dir):
                continue
            for entry in sorted(os.listdir(search_dir)):
                if entry == "templates":
                    continue
                colors_path = os.path.join(search_dir, entry, "colors.toml")
                if os.path.isfile(colors_path):
                    try:
                        with open(colors_path, "rb") as f:
                            data = tomllib.load(f)
                        themes[entry] = {
                            "id": entry,
                            "name": data.get("name", entry.replace("-", " ").title()),
                            "mode": data.get("mode", "dark"),
                            "accent": data.get("accent", "#89b4fa"),
                            "background": data.get("background", "#1e1e2e"),
                            "source": "user" if ".config" in search_dir else "system",
                            "path": os.path.join(search_dir, entry)
                        }
                    except Exception:
                        pass
        return themes

    def get_theme_palette(self, theme_id):
        for search_dir in self.theme_search_dirs:
            candidate = os.path.join(search_dir, theme_id, "colors.toml")
            if os.path.isfile(candidate):
                with open(candidate, "rb") as f:
                    raw = tomllib.load(f)
                return normalize_palette(raw, theme_id=theme_id)

        raise FileNotFoundError(f"Theme {theme_id} not found")

    def apply_palette(self, pal):
        with open(self.lock_file, "w") as lock_fd:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            try:
                self._do_apply_palette(pal)
            finally:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)

    def _do_apply_palette(self, pal):
        theme_id = pal.get("id", "custom")
        staging_dir = os.path.join(self.state_dir, "staging")
        current_dir = os.path.join(self.state_dir, "current")
        shutil.rmtree(staging_dir, ignore_errors=True)
        os.makedirs(staging_dir, exist_ok=True)

        templates = {}
        for tpl_dir in reversed(self.tpl_search_dirs):
            if os.path.isdir(tpl_dir):
                for tpl in os.listdir(tpl_dir):
                    if tpl.endswith(".tpl"):
                        templates[tpl] = os.path.join(tpl_dir, tpl)

        rendered_files = {}
        for tpl_name, tpl_path in templates.items():
            dest_name = tpl_name[:-4]
            with open(tpl_path, "r", encoding="utf-8") as f:
                content = f.read()
            rendered = render_template(content, pal)
            staged_path = os.path.join(staging_dir, dest_name)
            with open(staged_path, "w", encoding="utf-8") as f:
                f.write(rendered)
            rendered_files[dest_name] = rendered

        colors_json_content = json.dumps(pal, indent=2)
        with open(os.path.join(staging_dir, "colors.json"), "w", encoding="utf-8") as f:
            f.write(colors_json_content)

        pal_mode = pal.get("mode", "dark")
        sh_lines = [f'export ZOI_THEME="{theme_id}"\n', f'export ZOI_THEME_MODE="{pal_mode}"\n']
        for k, v in pal.items():
            if k not in ["id", "name", "mode"]:
                sh_lines.append(f'export ZOI_COLOR_{k.upper()}="{with_hash(v)}"\n')
        with open(os.path.join(staging_dir, "colors.sh"), "w", encoding="utf-8") as f:
            f.writelines(sh_lines)

        toml_lines = [f'mode = "{pal_mode}"\n\n']
        for k, v in pal.items():
            if k not in ["id", "name", "mode"]:
                toml_lines.append(f'{k} = "{with_hash(v)}"\n')
        with open(os.path.join(staging_dir, "colors.toml"), "w", encoding="utf-8") as f:
            f.writelines(toml_lines)

        shutil.rmtree(current_dir, ignore_errors=True)
        shutil.move(staging_dir, current_dir)

        self._dispatch_foot(rendered_files.get("foot.ini"))
        self._dispatch_btop(rendered_files.get("btop.theme"))
        self._dispatch_sway(rendered_files.get("sway.theme.conf"), pal)
        self._dispatch_helix(rendered_files.get("helix.toml"))
        self._dispatch_zed(rendered_files.get("zed.json"))
        self._dispatch_vscode(pal)
        self._dispatch_gtk(rendered_files.get("gtk-3.0.css"), rendered_files.get("gtk-4.0.css"), pal)
        self._dispatch_herdr(pal)
        self._dispatch_limine(rendered_files.get("limine.conf"))
        self._dispatch_lemurs(rendered_files.get("lemurs-variables.toml"), pal)
        self._dispatch_yazi(rendered_files.get("yazi-theme.toml"))
        self._dispatch_inlyne(pal)
        self._dispatch_state(pal, colors_json_content, sh_lines)
        self._run_hooks(theme_id)

    def _dispatch_foot(self, content):
        if not content:
            return
        foot_path = os.path.join(self.home, ".config/foot/foot.ini")
        os.makedirs(os.path.dirname(foot_path), exist_ok=True)
        with open(foot_path, "w", encoding="utf-8") as f:
            f.write(content)
        repo_foot = os.path.join(self.repo_root, "dotfiles/config/foot/foot.ini")
        if os.path.isdir(os.path.dirname(repo_foot)):
            with open(repo_foot, "w", encoding="utf-8") as f:
                f.write(content)
        # Live-update running foot terminals via OSC escape sequences
        self._osc_reload_foot(content)

    def _osc_reload_foot(self, content):
        """Send OSC escape sequences to all foot terminals to update colors live."""
        # Parse colors from the rendered foot.ini content
        colors = {}
        for line in content.splitlines():
            line = line.strip()
            if "=" in line and not line.startswith("[") and not line.startswith("#"):
                key, _, val = line.partition("=")
                colors[key.strip()] = val.strip()

        # Build OSC sequences
        # OSC 10 = foreground, OSC 11 = background, OSC 12 = cursor
        # OSC 4;N = palette color N (0-15)
        seqs = []
        if "foreground" in colors:
            seqs.append(f"\033]10;#{colors['foreground']}\033\\")
        if "background" in colors:
            seqs.append(f"\033]11;#{colors['background']}\033\\")
            seqs.append(f"\033]12;#{colors.get('foreground', 'ffffff')}\033\\")

        # Map foot.ini keys to ANSI color indices
        regular_keys = [
            "regular0", "regular1", "regular2", "regular3",
            "regular4", "regular5", "regular6", "regular7",
        ]
        bright_keys = [
            "bright0", "bright1", "bright2", "bright3",
            "bright4", "bright5", "bright6", "bright7",
        ]
        for i, key in enumerate(regular_keys):
            if key in colors:
                seqs.append(f"\033]4;{i};#{colors[key]}\033\\")
        for i, key in enumerate(bright_keys):
            if key in colors:
                seqs.append(f"\033]4;{8 + i};#{colors[key]}\033\\")

        if not seqs:
            return

        osc_payload = "".join(seqs)

        # Find all PTYs belonging to foot child processes and write OSC sequences
        try:
            foot_pids = subprocess.run(
                ["pgrep", "foot"], capture_output=True, text=True, timeout=5
            ).stdout.strip().split()
            for fpid in foot_pids:
                if not fpid:
                    continue
                # Find child shell processes of foot
                children = subprocess.run(
                    ["pgrep", "-P", fpid], capture_output=True, text=True, timeout=5
                ).stdout.strip().split()
                for cpid in children:
                    if not cpid:
                        continue
                    try:
                        tty = os.readlink(f"/proc/{cpid}/fd/0")
                        if tty.startswith("/dev/pts/"):
                            with open(tty, "w") as f:
                                f.write(osc_payload)
                    except (OSError, IOError):
                        pass
        except Exception:
            pass

    def _dispatch_btop(self, content):
        if not content:
            return
        btop_dir = os.path.join(self.home, ".config/btop")
        themes_dir = os.path.join(btop_dir, "themes")
        os.makedirs(themes_dir, exist_ok=True)
        with open(os.path.join(themes_dir, "zoi.theme"), "w", encoding="utf-8") as f:
            f.write(content)

        btop_cfg = os.path.join(btop_dir, "btop.conf")
        if os.path.exists(btop_cfg):
            with open(btop_cfg, "r", encoding="utf-8") as f:
                lines = f.readlines()
            new_lines = []
            theme_set = False
            for line in lines:
                if line.strip().startswith("color_theme ="):
                    new_lines.append('color_theme = "zoi"\n')
                    theme_set = True
                else:
                    new_lines.append(line)
            if not theme_set:
                new_lines.insert(0, 'color_theme = "zoi"\n')
            with open(btop_cfg, "w", encoding="utf-8") as f:
                f.writelines(new_lines)

    def _dispatch_sway(self, content, pal):
        if content:
            sway_theme = os.path.join(self.home, ".config/sway/theme.conf")
            os.makedirs(os.path.dirname(sway_theme), exist_ok=True)
            with open(sway_theme, "w", encoding="utf-8") as f:
                f.write(content)
            repo_sway = os.path.join(self.repo_root, "dotfiles/sway/theme.conf")
            if os.path.isdir(os.path.dirname(repo_sway)):
                with open(repo_sway, "w", encoding="utf-8") as f:
                    f.write(content)

        accent = pal.get("accent", "#89b4fa")
        bg_dark = pal.get("dark_background", "#181825")
        bg_light = pal.get("lighter_background", "#313244")
        fg = pal.get("foreground", "#cdd6f4")
        muted = pal.get("muted", "#6c7086")
        urgent = pal.get("red", "#f38ba8")
        orange = pal.get("orange", "#fab387")

        cmd = [
            "swaymsg",
            f"client.focused '{accent}' '{accent}' '{bg_dark}' '{orange}' '{accent}'; "
            f"client.focused_inactive '{bg_light}' '{bg_light}' '{fg}' '{bg_light}' '{bg_light}'; "
            f"client.unfocused '{bg_dark}' '{bg_dark}' '{muted}' '{bg_dark}' '{bg_dark}'; "
            f"client.urgent '{urgent}' '{urgent}' '{bg_dark}' '{urgent}' '{urgent}'"
        ]
        subprocess.run(cmd, capture_output=True, timeout=1)

    def _dispatch_helix(self, content):
        if not content:
            return
        helix_dir = os.path.join(self.home, ".config/helix")
        themes_dir = os.path.join(helix_dir, "themes")
        os.makedirs(themes_dir, exist_ok=True)
        with open(os.path.join(themes_dir, "zoi.toml"), "w", encoding="utf-8") as f:
            f.write(content)

        helix_cfg = os.path.join(helix_dir, "config.toml")
        if os.path.exists(helix_cfg):
            with open(helix_cfg, "r", encoding="utf-8") as f:
                lines = f.readlines()
            new_lines = []
            theme_set = False
            for line in lines:
                if line.strip().startswith("theme ="):
                    new_lines.append('theme = "zoi"\n')
                    theme_set = True
                else:
                    new_lines.append(line)
            if not theme_set:
                new_lines.insert(0, 'theme = "zoi"\n')
            with open(helix_cfg, "w", encoding="utf-8") as f:
                f.writelines(new_lines)

    def _dispatch_zed(self, content):
        if not content:
            return
        zed_dir = os.path.join(self.home, ".config/zed")
        themes_dir = os.path.join(zed_dir, "themes")
        os.makedirs(themes_dir, exist_ok=True)
        with open(os.path.join(themes_dir, "zoi.json"), "w", encoding="utf-8") as f:
            f.write(content)

        zed_settings = os.path.join(zed_dir, "settings.json")
        if os.path.exists(zed_settings):
            try:

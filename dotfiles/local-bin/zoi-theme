    def _assemble_limine_conf(self, theme_body):
        uuid = ""
        try:
            r = subprocess.run(["findmnt", "-no", "UUID", "/"], capture_output=True, text=True, timeout=3)
            uuid = (r.stdout or "").strip()
        except Exception:
            uuid = ""
        versions = []
        boot = "/boot"
        if os.path.isdir(boot):
            for name in os.listdir(boot):
                if not name.startswith("vmlinuz-"):
                    continue
                ver = name[len("vmlinuz-"):]
                if os.path.isfile(os.path.join(boot, "initrd.img-" + ver)):
                    versions.append(ver)
            try:
                r = subprocess.run(["sort", "-Vr"], input="\n".join(versions) + "\n", capture_output=True, text=True, timeout=3)
                versions = [v for v in (r.stdout or "").splitlines() if v]
            except Exception:
                versions.sort(reverse=True)
        lines = [
            "# Assembled by zoi-theme + limine-setup.sh. Theme: zoi-theme; entries: regenerated.",
            "timeout: 5",
            "default_entry: 1",
            "",
            "# zoi-theme-begin",
            theme_body.rstrip(),
            "# zoi-theme-end",
            "",
            "# zoi-entries-begin",
        ]
        cmdline = f"root=UUID={uuid} ro quiet" if uuid else "ro quiet"
        for ver in versions:
            kernel = f"guid({uuid}):/boot/vmlinuz-{ver}" if uuid else f"boot():/boot/vmlinuz-{ver}"
            initrd = f"guid({uuid}):/boot/initrd.img-{ver}" if uuid else f"boot():/boot/initrd.img-{ver}"
            lines.extend([
                f"/Debian {ver}",
                "    comment: Debian GNU/Linux (Limine)",
                "    protocol: linux",
                f"    path: {kernel}",
                f"    cmdline: {cmdline}",
                f"    module_path: {initrd}",
                "",
            ])
        lines.append("# zoi-entries-end")
        lines.append("")
        return "\n".join(lines)



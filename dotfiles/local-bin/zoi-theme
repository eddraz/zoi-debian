    @staticmethod
    def _merge_flat_toml(base_text, overlay_path):
        if not overlay_path or not os.path.isfile(overlay_path):
            return base_text
        overlay = {}
        try:
            with open(overlay_path, encoding="utf-8") as f:
                for line in f:
                    raw = line.strip()
                    if not raw or raw.startswith("#") or "=" not in raw:
                        continue
                    key, val = raw.split("=", 1)
                    overlay[key.strip()] = val.strip()
        except OSError:
            return base_text
        if not overlay:
            return base_text
        lines = []
        seen = set()
        for line in base_text.splitlines():
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and "=" in stripped:
                key = stripped.split("=", 1)[0].strip()
                if key in overlay:
                    lines.append(f"{key} = {overlay[key]}")
                    seen.add(key)
                    continue
            lines.append(line)
        for key, val in overlay.items():
            if key not in seen:
                lines.append(f"{key} = {val}")
        return "\n".join(lines) + "\n"

    @staticmethod
    def _write_if_writable(path, content):
        if not os.path.isfile(path) or not os.access(path, os.W_OK):
            return
        try:
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(content if content.endswith("\n") else content + "\n")
            os.replace(tmp, path)
        except OSError:
            pass




[Unit]
Description=Lemurs
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty2.service
Conflicts=getty@tty2.service

[Service]
# Kernel VT ignores hex; load the 16-color wallpaper map first.
ExecStartPre=-/usr/bin/setvtrgb /etc/lemurs/vtrgb
ExecStart=/usr/local/bin/lemurs
StandardInput=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
Type=idle

[Install]
Alias=display-manager.service
WantedBy=graphical.target
